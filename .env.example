# ========================
# Industrial AI Hub — Environment Variables (Template)
# Copy to .env and fill in real values
#
# ⚠️ 本文件是唯一提交到 Git 的模板：
#    - 只允许变量名 + 占位值（change_me / 示例值）
#    - 禁止放置任何真实密钥
#    - 真实值一律写入本地 .env（已被 .gitignore 排除，不进 Git）
# 详见 AGENTS.md §8 / docs/decision-log/0015-dev-env-secrets-ssot.md
# ========================

# MySQL (Docker standalone)
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=reboot

# MySQL (Master-Slave cluster)
MYSQL_MS_ROOT_PASSWORD=change_me

# Spring Boot Application DB Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change_me

# EMQX (Phase 5 MQTT Broker, ADR 0033)
# Dashboard 默认账号 admin；首次启动用此密码引导。本地 EMQX 当前允许匿名直连（仅内网开发）。
EMQX_DASHBOARD_PASSWORD=change_me

# Backend MQTT Listener (Phase 5 Day 96, ADR 0034)
# 非敏感默认值；容器化部署由 compose.yml 注入 MQTT_ENABLED=true/MQTT_HOST=emqx
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Backend 容器编排（Day 104，均非敏感、有默认值）
# 宿主机 dev 后端占用 8080 时，容器 backend 改用其他端口对外（如 8082）
BACKEND_HOST_PORT=8080
# 容器 backend 的 MQTT clientId：与宿主机实例并存时必须不同，否则 EMQX 互踢下线（Day 101 坑位）
MQTT_CLIENT_ID=iah-backend-container
# 限流/节流（Day 103, ADR 0037，rate.limit.* 容器环境变量注入）
RATE_LIMIT_PERMITS=50
RATE_LIMIT_ACQUIRE_TIMEOUT_MS=500
RATE_LIMIT_LOG_INTERVAL_MS=5000
# local = 单实例 Guava；redis = 多实例共享 Lua 令牌桶（Redis 异常自动回退 local）
RATE_LIMIT_MODE=local
# 单登录用户/IP 的通用接口额度；与 path 全局桶同时生效
RATE_LIMIT_IDENTITY_PERMITS=20

# RAG（ADR 0040，默认保持离线，不要求外部服务）
# vector-store: simple | qdrant
# embedding provider: hash | openai-compatible
RAG_VECTOR_STORE=simple
RAG_EMBEDDING_PROVIDER=hash
# 0 = provider 默认维度（hash 256 / openai-compatible 1536）
RAG_EMBEDDING_DIMENSIONS=0
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_SEND_DIMENSIONS=true
QDRANT_BASE_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=industrial_ai_hub_knowledge
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10

# Frontend / Grafana
FRONTEND_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me

# Nacos
NACOS_AUTH_IDENTITY_KEY=nacos
NACOS_AUTH_IDENTITY_VALUE=nacos
NACOS_AUTH_TOKEN=change_me_to_at_least_32_characters_long_secret_key

# JWT
JWT_SECRET=generate_a_random_256_bit_secret_key_here_replace_me
JWT_EXPIRATION_MS=86400000

# DeepSeek (Phase 4 AI, OpenAI compatible; optional)
# 默认关闭；启用时填写真实 API Key（dev 读取根目录 .env，禁止提交真实密钥）
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=change_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=1024

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MCP (Phase 4 AI, ADR 0029)
# MCP_ACCESS_TOKEN 非空启用 X-MCP-Token 门（/mcp/sse 与 /mcp/message 校验），留空 = 内网可信直连；
# 公网/跨主机部署必须生成强随机值（如 openssl rand -base64 48）
MCP_ACCESS_TOKEN=
# MCP 客户端冒烟连接目标（默认本服务，进程内联调无需修改）
MCP_CLIENT_BASE_URL=http://localhost:8080
MCP_CLIENT_SSE_ENDPOINT=/mcp/sse
