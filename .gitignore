# ========================
# Industrial AI Hub — .gitignore
# ========================
.env
out/
*.log

# 本地 Compose 覆盖（机器级补丁，禁止入库；部署修复一律走仓库 main）
compose.override.yml

# macOS
.DS_Store

# ========================
# IDE & AI 代理产物（多 AI 协作卫生，避免藏污纳垢）
# Codex / DeepSeek / Qoder / Workbuddy / Cursor / Claude / Aider 等
# ========================
.idea/
.vscode/
*.iml
.qodana/
.qoder/
.workbuddy/
.codex/
.cursor/
.claude/
.aider/
.copilot/
.amazonq/
.windsurf/
.trae/

# Java
backend/target/
backend/.qodana/
backend/**/*.class

# Frontend
frontend/node_modules/
frontend/dist/

# Infrastructure runtime data (Docker persistent volumes)
# Entire directories excluded — Git tracks only config, not data
mysql/data/
mysql/ms-data/
redis/data/
nginx/logs/
rabbitmq/*
elasticsearch/
minio/
nacos/

# Archives
*.tar.gz

# RabbitMQ: config tracked, runtime ignored
!rabbitmq/rabbitmq.conf
!rabbitmq/enabled_plugins
!rabbitmq/definitions.json
