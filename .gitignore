# ========================
# Industrial AI Hub — .gitignore
# ========================
.env
.idea/
*.iml
out/
*.log
.DS_Store

# Java
backend/target/
backend/.qodana/
backend/**/*.class

# Frontend
frontend/node_modules/
frontend/dist/

# Infrastructure runtime data (Docker persistent volumes)
# Entire directories excluded — Git tracks only config, not data
mysql/data/
mysql/ms-data/
redis/data/
nginx/logs/
rabbitmq/
elasticsearch/
minio/
nacos/

# Archives
*.tar.gz

# RabbitMQ: config tracked, runtime ignored
!rabbitmq/rabbitmq.conf
!rabbitmq/enabled_plugins
!rabbitmq/definitions.json
