					"name": "分页查询 — 第1页",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('code=200', function() { pm.expect(pm.response.json().code).to.eql(200); });",
									"pm.test('返回分页结构', function() {",
									"    var data = pm.response.json().data;",
									"    pm.expect(data).to.have.property('pageNum');",
									"    pm.expect(data).to.have.property('pageSize');",
									"    pm.expect(data).to.have.property('total');",
									"    pm.expect(data).to.have.property('list');",
									"    pm.expect(data.list).to.be.an('array');",
									"});",
									"pm.test('UserVO 不含 password', function() {",
									"    var list = pm.response.json().data.list;",
									"    if (list.length > 0) {",
									"        pm.expect(list[0]).to.not.have.property('password');",
									"    }",
									"});"
								]
							}
						}
