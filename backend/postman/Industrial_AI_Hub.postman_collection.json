					"name": "注册 — 正常",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('状态码 200', function() { pm.response.to.have.status(200); });",
									"pm.test('code=200 注册成功', function() {",
									"    var json = pm.response.json();",
									"    pm.expect(json.code).to.eql(200);",
									"    pm.expect(json.message).to.include('注册成功');",
									"    pm.expect(json.data).to.have.property('id');",
									"    pm.expect(json.data).to.not.have.property('password');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"test123456\"\n}"
						}
					}
				},
				{
					"name": "注册 — 用户名已存在 409",
