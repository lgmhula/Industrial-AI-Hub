<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback 配置（Day 101 — 日志系统）

  · CONSOLE   — 高亮人类可读，全环境；pattern 含 %X{traceId:-}（TraceIdFilter 注入）
  · FILE      — 按天 + 单文件 100MB 滚动，gzip 归档，保留 14 天 / 总量上限 2GB
  · ERROR_FILE — 仅 ERROR 级独立文件，排障免翻全量日志
  · test profile 仅 CONSOLE：@SpringBootTest 不产生日志文件污染工作区
  · 日志级别仍由 application*.yml 的 logging.level 控制（Boot 启动时覆盖 root）
-->
<configuration scan="true" scanPeriod="30 seconds">

    <contextName>industrial-ai-hub</contextName>

    <property name="LOG_HOME" value="logs"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] %logger{36} - %msg%n"/>

    <!-- 控制台：开发主视图，traceId 为空时显示 []（无 Filter 参与的启动期/测试日志） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{traceId:-}] %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 全量文件：SizeAndTimeBasedRollingPolicy = 时间触发滚动 + 大小切分，gzip 历史归档 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/industrial-ai-hub.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/industrial-ai-hub.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 错误专用文件：LevelFilter 精确匹配 ERROR（onMatch ACCEPT / onMismatch DENY） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>512MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 常规环境：控制台 + 全量文件 + 错误文件 -->
    <springProfile name="!test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- 测试环境：仅控制台，不落盘 -->
    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
